MimeType=x-scheme-handler/scrinium;
Icon=scrinium
Terminal=false
Categories=Utility;
Keywords=notes;memo;password;lock;vault;
Keywords[fr]=fiches;mémo;mot de passe;verrou;coffre;
StartupWMClass=scrinium
