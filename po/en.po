msgstr "(locked)"

#: src/scrinium/ui/fenetre.py:328
msgid ""
"Fiche verrouillée.\n"
"\n"
"Cliquer sur « Déverrouiller… » (ou double-clic sur la fiche) et saisir le "
"mot de passe."
msgstr ""
"Locked note.\n"
"\n"
"Click \"Unlock…\" (or double-click the note) and enter the password."

#: src/scrinium/ui/fenetre.py:330
msgid "Verrouillée"
msgstr "Locked"

#: src/scrinium/ui/fenetre.py:333
msgid "Verrouillée (ouverte)"
msgstr "Locked (open)"

#: src/scrinium/ui/fenetre.py:333 src/scrinium/ui/fenetre.py:399
msgid "✔ Enregistré"
msgstr "✔ Saved"

#: src/scrinium/ui/fenetre.py:334
msgid "modifié le"
msgstr "modified on"

#: src/scrinium/ui/fenetre.py:337
msgid "Aucune fiche : « Fiche » (Ctrl+N)"
msgstr "No notes: \"Note\" (Ctrl+N)"

#: src/scrinium/ui/fenetre.py:367
msgid "Supprimer"
msgstr "Delete"

#: src/scrinium/ui/fenetre.py:368
#, python-format
msgid "Mettre la fiche « %s » à la corbeille ?"
msgstr "Move the note \"%s\" to the trash?"

#: src/scrinium/ui/fenetre.py:379
msgid "● modification en cours…"
msgstr "● editing…"

#: src/scrinium/ui/fenetre.py:394
msgid "✔ Enregistré à"
msgstr "✔ Saved at"

#: src/scrinium/ui/fenetre.py:409
msgid "Langue"
msgstr "Language"

#: src/scrinium/ui/fenetre.py:409
msgid "Langue modifiée : redémarrez Scrinium pour l'appliquer."
msgstr "Language changed: restart Scrinium to apply it."

#: src/scrinium/ui/fenetre.py:415
msgid "Démarrage de la session"
msgstr "Login startup"

#: src/scrinium/ui/fenetre.py:415
#, python-format
msgid "Impossible de modifier le lancement automatique : %s"
msgstr "Could not change automatic startup: %s"

#: src/scrinium/ui/fenetre.py:425
msgid "Pas de zone de notification sur ce bureau."
msgstr "No notification area on this desktop."

#: src/scrinium/ui/fenetre.py:430
msgid "Ouvrir Scrinium"
msgstr "Open Scrinium"

#: src/scrinium/ui/fenetre.py:431
msgid "Nouvelle fiche"
msgstr "New note"

#: src/scrinium/ui/fenetre.py:496
msgid "Déverrouiller…"
msgstr "Unlock…"

#: src/scrinium/ui/fenetre.py:498 src/scrinium/ui/fenetre.py:578
msgid "Retirer le mot de passe"
msgstr "Remove password"

#: src/scrinium/ui/fenetre.py:510
msgid "✔ Note copiée dans le presse-papiers"
msgstr "✔ Note copied to the clipboard"

#: src/scrinium/ui/fenetre.py:533 src/scrinium/ui/fenetre.py:542
msgid "Fiche verrouillée"
msgstr "Locked note"

#: src/scrinium/ui/fenetre.py:533
#, python-format
msgid "Mot de passe de « %s » :"
msgstr "Password for \"%s\":"

#: src/scrinium/ui/fenetre.py:539
msgid "Mot de passe incorrect."
msgstr "Wrong password."

#: src/scrinium/ui/fenetre.py:542
#, python-format
msgid "Lecture impossible : %s"
msgstr "Cannot read: %s"

#: src/scrinium/ui/fenetre.py:552 src/scrinium/ui/fenetre.py:556
msgid ""
"Mot de passe oublié : le fichier de secours permettra de rouvrir la fiche."
msgstr "Forgotten password: the rescue file will let you reopen the note."

#: src/scrinium/ui/fenetre.py:554
msgid "Pas de fichier de secours : mot de passe oublié = fiche perdue."
msgstr "No rescue file: forgotten password = lost note."

#: src/scrinium/ui/fenetre.py:557
msgid "Verrouiller la fiche"
msgstr "Lock the note"

#: src/scrinium/ui/fenetre.py:558
msgid ""
"Le texte de la fiche sera chiffré avec un mot de passe (le titre reste "
"visible).\n"
"\n"
msgstr ""
"The note text will be encrypted with a password (the title stays visible).\n"
"\n"

#: src/scrinium/ui/fenetre.py:561
msgid "Mot de passe (4 caractères minimum) :"
msgstr "Password (4 characters minimum):"

#: src/scrinium/ui/fenetre.py:561 src/scrinium/ui/fenetre.py:567
msgid "Verrouiller"
msgstr "Lock"

#: src/scrinium/ui/fenetre.py:565
msgid "Trop court (4 caractères minimum)."
msgstr "Too short (4 characters minimum)."

#: src/scrinium/ui/fenetre.py:569
msgid "Les deux saisies sont différentes, fiche non verrouillée."
msgstr "The two entries differ, note not locked."

#: src/scrinium/ui/fenetre.py:579
msgid "Le texte de la fiche sera de nouveau stocké en clair. Continuer ?"
msgstr "The note text will be stored in plain text again. Continue?"

#: src/scrinium/ui/fenetre.py:594
msgid "Avant de verrouiller : voulez-vous créer un fichier de secours ?"
msgstr "Before locking: do you want to create a rescue file?"

#: src/scrinium/ui/fenetre.py:595
msgid ""
"Si vous oubliez le mot de passe d'une fiche, le fichier de secours permet de "
"la rouvrir. Sans lui, une fiche dont le mot de passe est oublié est perdue "
"pour toujours."
msgstr ""
"If you forget a note's password, the rescue file lets you reopen it. Without "
"it, a note whose password is forgotten is lost forever."

#: src/scrinium/ui/fenetre.py:598
msgid "Verrouiller sans fichier de secours"
msgstr "Lock without a rescue file"

#: src/scrinium/ui/fenetre.py:599
msgid "Annuler"
msgstr "Cancel"

#: src/scrinium/ui/fenetre.py:612
msgid ""
"Un fichier de secours est déjà actif.\n"
"\n"
"En créer un nouveau ? Il servira pour les fiches verrouillées à partir de "
"maintenant ; les fiches déjà verrouillées ne s'ouvriront qu'avec l'ancien."
msgstr ""
"A rescue file is already active.\n"
"\n"
"Create a new one? It will be used for notes locked from now on; notes "
"already locked can only be opened with the old one."

#: src/scrinium/ui/fenetre.py:623
msgid "Sélectionnez d'abord une fiche verrouillée."
msgstr "Select a locked note first."

#: src/scrinium/ui/fenetre.py:631
msgid "Mot de passe du fichier de secours :"
msgstr "Rescue file password:"

#: src/scrinium/ui/fenetre.py:637
#, python-format
msgid "Impossible de rouvrir la fiche : %s"
msgstr "Could not reopen the note: %s"

#: src/scrinium/ui/fenetre.py:640
msgid "Fiche rouverte. La remettre en clair (retirer le mot de passe) ?"
msgstr "Note reopened. Put it back in plain text (remove the password)?"

#. reste fermée ; rien n'a été écrit
#: src/scrinium/ui/fenetre.py:645
msgid "Fiche toujours verrouillée."
msgstr "Note still locked."

#: src/scrinium/ui/fenetre.py:654
msgid "Fiches rangées par thème, verrouillables (AES-256-GCM)."
msgstr "Notes organised by topic, lockable (AES-256-GCM)."
